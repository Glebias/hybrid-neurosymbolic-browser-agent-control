# Copy only for a new installation. Never commit .env or put keys in frontend.
GROQ_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
# Set true only for a confirmed Free plan / Free Tier without paid billing.
GROQ_FREE_PLAN_CONFIRMED=false
GOOGLE_FREE_PLAN_CONFIRMED=false
AGENT_PROVIDER=codex
AGENT_MODEL=gpt-6.1-sol
GUARD_PROVIDER=codex
GUARD_MODEL=gpt-6.1-sol
# Free API controls after confirming plans:
# AGENT_PROVIDER=google
# AGENT_MODEL=gemini-2.5-flash
# GUARD_PROVIDER=groq
# GUARD_MODEL=openai/gpt-oss-120b
VISUAL_PROVIDER=zai
VISUAL_MODEL=glm-4.6v-flash
GUARD_URL=http://127.0.0.1:8765
BROWSER_HEADLESS=true
CONFIRMATION_TIMEOUT=120
MAX_ACTIONS_PER_STEP=3
ANONYMIZED_TELEMETRY=false
BROWSER_USE_SETUP_LOGGING=false
